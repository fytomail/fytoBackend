PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/prime-wave
JWT_SECRET=some_jwt_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=https://meetkishore.in,http://localhost:3000,http://localhost:5173,*
CLIENT_URL=https://meetkishore.in
CORS_CREDENTIALS=true

# Dynamic Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_MESSAGE=Too many requests, please try again later.

# API Configuration
API_PREFIX=/api/v1

# Mail Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Prime Wave <noreply@primewave.com>

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage Configuration
CLOUD_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
