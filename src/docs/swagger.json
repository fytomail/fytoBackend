{
  "openapi": "3.0.0",
  "info": {
    "title": "Prime Wave Backend API Suite",
    "version": "2.0.0",
    "description": "Interactive API Documentation covering all 22 route groups mapped to the 19 BRDs."
  },
  "servers": [
    {
      "url": "http://localhost:5001",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health Check Status",
        "responses": {
          "200": { "description": "Server is healthy" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": ["Authentication & User Management (BRD 01)"],
        "summary": "User Registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "test@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "password123" },
                  "role": { "type": "string", "enum": ["student", "recruiter"], "default": "student" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Authentication & User Management (BRD 01)"],
        "summary": "User Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "test@example.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Authentication & User Management (BRD 01)"],
        "summary": "User Logout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/auth/refresh-tokens": {
      "post": {
        "tags": ["Authentication & User Management (BRD 01)"],
        "summary": "Refresh Auth Tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
